{
  "name": "brimmar/phpstan-rustlike-result-extension",
  "description": "PHPStan extension to help the Result Type implementation",
  "type": "phpstan-extension",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Brimmar\\PHPStan\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Brimmar\\PHPStan\\Tests\\": "tests/",
      "Brimmar\\PhpResult\\": "tests/Fixture/Result/",
      "Brimmar\\PhpOption\\": "tests/Fixture/Option/"
    }
  },
  "authors": [
    {
      "name": "Bryan",
      "email": "bryan.sergio@brimmar.dev"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.5",
    "phpstan/phpstan": "^2.3"
  },
  "conflict": {
    "brimmar/phpresult": "<4.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4.1",
    "phpstan/phpstan-strict-rules": "^2.1",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-phpunit": "^2.1",
    "laravel/pint": "^1.32"
  },
  "extra": {
    "phpstan": {
      "includes": [
        "extension.neon"
      ]
    }
  },
  "scripts": {
    "format": "pint",
    "format:check": "pint --test",
    "analyse": "phpstan analyse --no-progress",
    "test": "phpunit",
    "check": [
      "@format:check",
      "@analyse",
      "@test"
    ]
  }
}
